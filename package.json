{
  "name": "ghost-commit",
  "version": "0.1.0",
  "description": "Detect AI-written commits that never ran the tests they claim — open-source toolkit by zAx4hub.",
  "type": "module",
  "author": "zAx4hub <zAx4hub@users.noreply.github.com>",
  "license": "MIT",
  "bin": {
    "ghost-commit": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
