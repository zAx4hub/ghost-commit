    "demo": "tsx src/cli.ts demo",
    "start": "tsx src/cli.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "zax4hub",
    "ghost-commit",
    "routing",
    "flagship"
  ],
  "repository": {
    "type": "git",
